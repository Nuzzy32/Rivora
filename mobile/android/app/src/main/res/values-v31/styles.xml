<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: splash sistem memakai ikon adaptif (logo) di atas putih. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
